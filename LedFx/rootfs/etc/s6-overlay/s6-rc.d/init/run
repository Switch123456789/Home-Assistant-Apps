#!/usr/bin/with-contenv bashio
    bashio::log.info "$(bashio::services mqtt 'username') - $(bashio::services mqtt 'password')"
    if [ ! -f "/config/config.json" ]; then
        cp -p -r "/root/.ledfx.default/"* "/config"
        sed -i "s/            \"username\": \"CHANGE ME\"/            \"username\": \"$(bashio::services mqtt 'username')\"/" "/config/config.json"
        sed -i "s/            \"password\": \"CHANGE ME\"/            \"password\": \"$(bashio::services mqtt 'password')\"/" "/config/config.json"
        bashio::log.warning "NO LEDFX CONFIGURATION-FILES FOUND, RESTORED DEFAULTS!"
    fi
    ln -s "/config/" "/root/.ledfx";
    bashio::log.info "FINISHED INITIALIZATION!"