#!/usr/bin/with-contenv bashio
if [ ! -f "/config/config.json" ]; then {
    echo "{"
    echo "    \"allowed_hosts\": [\"*\"],"
    echo "    \"allowed_origins\": [\"*\"],"
    echo "    \"audio\": {"
    echo "        \"audio_device\": 2"
    echo "    },"
    echo "    \"configuration_version\": \"2.3.6\","
    echo "    \"sendspin_servers\": {"
    echo "        \"music-assistant\": {"
    echo "            \"client_name\": \"LedFx\","
    echo "            \"server_url\": \"ws://[::1]:8927/sendspin\""
    echo "        }"
    if bashio::services.available "mqtt"; then
        echo "    },"
        echo "    \"virtuals\": ["
        echo "        {"
        echo "            \"auto_generated\": false,"
        echo "            \"config\": {"
        echo "                \"name\": \"Dummy\""
        echo "            },"
        echo "            \"id\": \"dummy\","
        echo "            \"is_device\": \"dummy\""
        echo "        }"
        echo "    ],"
        echo "    \"integrations\": ["
        echo "    {"
        echo "        \"active\": true,"
        echo "        \"config\": {"
        echo "            \"description\": \"MQTT Integration with auto-discovery\","
        echo "            \"ip_address\": \"::1\","
        echo "            \"name\": \"Home Assistant\","
        echo "            \"password\": \"$(bashio::services mqtt 'password')\","
        echo "            \"port\": $(bashio::services mqtt "port"),"
        echo "            \"topic\": \"homeassistant\","
        echo "            \"username\": \"$(bashio::services mqtt 'username')\""
        echo "        },"
        echo "            \"data\": [],"
        echo "            \"id\": \"home-assistant\","
        echo "            \"type\": \"mqtt_hass\""
        echo "        }"
        echo "    ]"
    else
        echo "    }"
    fi
    echo "}"
} > /config/config.json; bashio::log.warning "NO LEDFX CONFIGURATION-FILES FOUND, RESTORED DEFAULTS!"; fi
ln -s "/config/" "/root/.ledfx";
bashio::log.info "FINISHED INITIALIZATION!"